<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_dept_level" model="ir.module.category">
        <field name="name">Sales Dept. Level</field>
        <field name="parent_id" ref="base.module_category_sales_management"/>
        <field name="sequence">5</field>
    </record>

    <record id="group_delivery_address_manager" model="res.groups">
        <field name="name">Sales Delivery Address</field>
        <field name="category_id" ref="module_category_sales_dept_level"/>
        <!-- <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/> -->
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('dex_city.group_delivery_address_manager'))]"/>
    </record>

    <record id="group_proper_address_manager" model="res.groups">
        <field name="name">Proper Address Manager</field>
        <field name="category_id" ref="module_category_sales_dept_level"/>
        <field name="implied_ids" eval="[(4, ref('dex_city.group_delivery_address_manager'))]"/>
    </record>
</odoo>
