<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_dex_city_global_import" model="ir.cron">
        <field name="name">Dex City Global Location Import</field>
        <field name="model_id" ref="model_dex_city_data_import"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_import()</field>
        <field name="activity_user_type">specific</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
