    <record id="view_dex_city_data_import_tree" model="ir.ui.view">
        <field name="name">dex.city.data.import.tree</field>
        <field name="model">dex.city.data.import</field>
        <field name="arch" type="xml">
            <tree string="Global Data Imports" delete="false">
                <field name="name"/>
                <field name="state"/>
                <field name="city_rows"/>
                <field name="ph_rows"/>
                <field name="postal_rows"/>
                <field name="processed_cities"/>
                <field name="processed_postal_codes"/>
                <field name="skipped_postal_codes"/>
                <field name="create_date"/>
                <field name="completed_at"/>
            </tree>
        </field>
    </record>

    <record id="view_dex_city_data_import_form" model="ir.ui.view">
        <field name="name">dex.city.data.import.form</field>
        <field name="model">dex.city.data.import</field>
        <field name="arch" type="xml">
            <form string="Global Location Data Import" create="true" edit="true" delete="false">
                <header>
                    <button name="action_preview" string="Download and Preview" type="object" class="oe_highlight" states="draft,failed"/>
                    <button name="action_queue" string="Apply Update" type="object" class="oe_highlight" states="ready"/>
                    <button name="action_retry" string="Retry" type="object" class="oe_highlight" states="failed"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,queued,processing,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="cities_url"/>
                            <field name="admin1_url"/>
                            <field name="ph_url"/>
                            <field name="postal_url"/>
                            <field name="attribution"/>
                        </group>
                        <group>
                            <field name="city_rows"/>
                            <field name="ph_rows"/>
                            <field name="postal_rows"/>
                            <field name="processed_cities"/>
                            <field name="processed_postal_codes"/>
                            <field name="skipped_postal_codes"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group string="Checksums">
                        <field name="cities_checksum"/>
                        <field name="ph_checksum"/>
                        <field name="postal_checksum"/>
                    </group>
                    <field name="error_message" attrs="{'invisible': [('error_message', '=', False)]}"/>
                    <field name="cities_archive" invisible="1"/>
                    <field name="admin1_file" invisible="1"/>
                    <field name="ph_archive" invisible="1"/>
                    <field name="postal_archive" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dex_city_data_imports" model="ir.actions.act_window">
        <field name="name">Global Data Imports</field>
        <field name="res_model">dex.city.data.import</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_dex_city_data_import_tree"/>
    </record>

